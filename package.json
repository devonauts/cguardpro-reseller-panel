{
  "name": "cguard-reseller-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel de socio de marca blanca — aplicación independiente contra el backend compartido.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:firewall && tsc && vite build && node scripts/sellar-integridad.mjs && npm run check:bundle",
