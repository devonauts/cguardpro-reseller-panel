  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "20.5.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^29.1.1",
    "sass": "^1.104.1",
    "typescript": "5.6.3",
    "vite": "6.0.11",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
