    "axios": "^1.12.2",
    "leaflet": "^1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "6.23.0",
    "socket.io-client": "^4.8.4"
